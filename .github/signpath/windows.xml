<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="windows-x64/fleab.exe" product-name="Fleab"
             product-version="${version}" file-version="${version}"
             original-filename="fleab.exe">
      <authenticode-sign />
    </pe-file>
    <pe-file path="windows-arm64/fleab.exe" product-name="Fleab"
             product-version="${version}" file-version="${version}"
             original-filename="fleab.exe">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
